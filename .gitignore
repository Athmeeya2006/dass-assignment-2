# Ignore everything by default
*

# Keep ignore rules file
!.gitignore

# Keep root README
!README.md

# Keep integration submission files
!integration/
integration/*
!integration/code/
!integration/code/**
!integration/tests/
!integration/tests/**
!integration/diagrams/
!integration/diagrams/**
!integration/report.pdf

# Keep blackbox submission files
!blackbox/
blackbox/*
!blackbox/tests/
!blackbox/tests/**
!blackbox/report.pdf

# Keep whitebox submission files
!whitebox/
whitebox/*
!whitebox/code/
!whitebox/code/**
!whitebox/tests/
!whitebox/tests/**
!whitebox/diagrams/
!whitebox/diagrams/**
!whitebox/report.pdf

# Ignore working notes and non-submission artifacts
scripts/
whitebox/manual_submission_guide.md
whitebox/report.md
whitebox/scripts/
integration/report_template.md
integration/test_report.html
integration/assets/
integration/requirements.txt
integration/diagrams/*.mmd
integration/diagrams/*.mermaid
blackbox/report.html
blackbox/bug_reports/
blackbox/requirements.txt
*.DS_Store
whitebox/diagrams/*.mmd
whitebox/diagrams/*.mermaid

# Always ignore generated Python/test artifacts
**/__pycache__/
*.py[cod]
**/.pytest_cache/
*.coverage
coverage.xml
